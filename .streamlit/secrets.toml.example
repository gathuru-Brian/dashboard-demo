# Do not commit a real secrets.toml. Add production secrets in your Streamlit
# deployment's Settings > Secrets panel instead.
#
# Example:
# [admin]
# email = "admin@your-company.com"
# password = "use-a-strong-unique-password"
#
# Password reset codes are sent through SMTP. Do not store these values in Git.
# [smtp]
# host = "smtp.your-company.com"
# port = 465
# username = "smtp-username"
# password = "smtp-password"
# sender = "no-reply@your-company.com"
# use_ssl = true
